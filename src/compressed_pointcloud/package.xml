<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>compressed_pointcloud</name>
  <version>0.1.0</version>
  <description>
    Subscribe to sensor_msgs/PointCloud2 (e.g. /ouster/points), encode with Draco,
    and republish as foxglove_msgs/CompressedPointCloud for Foxglove 3D panel.
  </description>
  <maintainer email="ubicomp@todo.todo">ubicomp</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>sensor_msgs_py</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>foxglove_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
